{
  "manifest_version": 3,
  "name": "AI API コストメーター",
  "version": "1.1.0",
  "description": "ブラウザから呼び出された Claude / Gemini API の利用コストを自動で概算・記録します。",
  "permissions": ["storage", "webRequest"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://gemini.google.com/*"],
      "js": ["pricing.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI API コストメーター",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
